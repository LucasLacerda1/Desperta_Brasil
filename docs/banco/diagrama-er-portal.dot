digraph modelo_do_banco {
  graph [rankdir=LR, splines=true, nodesep=0.25, ranksep=0.7, pad=0.4, bgcolor="#fefdfb", fontname="Helvetica", fontsize=22, labelloc=t, label="Desperta Brasil: tabelas do portal (11 tabelas)"];
  node [shape=plain, fontname="Helvetica", fontsize=12];
  edge [color="#956036", penwidth=1.1, arrowsize=0.8, dir=both];
  subgraph cluster_auth { label="Equipe (portal)"; style="rounded,filled"; color="#d8ccbf"; fillcolor="#f4f1ec"; fontsize=16; fontcolor="#263b5c";
    "administrador" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9c836f" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#263b5c"><FONT COLOR="#ffffff"><B>administrador</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#5f6d73">+ 8 colunas</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_noticias { label="Notícias (portal)"; style="rounded,filled"; color="#d8ccbf"; fillcolor="#f8efe6"; fontsize=16; fontcolor="#263b5c";
    "noticia" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9c836f" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#263b5c"><FONT COLOR="#ffffff"><B>noticia</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK</B></FONT></TD></TR><TR><TD PORT="cod_tema" ALIGN="LEFT">cod_tema</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>FK</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#5f6d73">+ 11 colunas</FONT></TD></TR></TABLE>>];
    "noticia_fonte" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9c836f" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#263b5c"><FONT COLOR="#ffffff"><B>noticia_fonte</B></FONT></TD></TR><TR><TD PORT="noticia_id" ALIGN="LEFT">noticia_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK FK</B></FONT></TD></TR><TR><TD PORT="tipo" ALIGN="LEFT">tipo</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK</B></FONT></TD></TR><TR><TD PORT="ref_id" ALIGN="LEFT">ref_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#5f6d73">+ 1 coluna</FONT></TD></TR></TABLE>>];
    "noticia_revisao" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9c836f" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#263b5c"><FONT COLOR="#ffffff"><B>noticia_revisao</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK</B></FONT></TD></TR><TR><TD PORT="noticia_id" ALIGN="LEFT">noticia_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>FK</B></FONT></TD></TR><TR><TD PORT="admin_id" ALIGN="LEFT">admin_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>FK</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#5f6d73">+ 3 colunas</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_ia { label="IA e busca (portal)"; style="rounded,filled"; color="#d8ccbf"; fillcolor="#eef1f6"; fontsize=16; fontcolor="#263b5c";
    "geracao_ia" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9c836f" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#263b5c"><FONT COLOR="#ffffff"><B>geracao_ia</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK</B></FONT></TD></TR><TR><TD PORT="noticia_id" ALIGN="LEFT">noticia_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>FK</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#5f6d73">+ 12 colunas</FONT></TD></TR></TABLE>>];
    "geracao_trecho" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9c836f" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#263b5c"><FONT COLOR="#ffffff"><B>geracao_trecho</B></FONT></TD></TR><TR><TD PORT="geracao_id" ALIGN="LEFT">geracao_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK FK</B></FONT></TD></TR><TR><TD PORT="trecho_id" ALIGN="LEFT">trecho_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK FK</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#5f6d73">+ 2 colunas</FONT></TD></TR></TABLE>>];
    "trecho_rag" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9c836f" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#263b5c"><FONT COLOR="#ffffff"><B>trecho_rag</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#5f6d73">+ 9 colunas</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_sistema { label="Sistema (portal)"; style="rounded,filled"; color="#d8ccbf"; fillcolor="#f1efec"; fontsize=16; fontcolor="#263b5c";
    "coleta" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9c836f" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#263b5c"><FONT COLOR="#ffffff"><B>coleta</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#5f6d73">+ 15 colunas</FONT></TD></TR></TABLE>>];
    "log_sistema" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9c836f" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#263b5c"><FONT COLOR="#ffffff"><B>log_sistema</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK</B></FONT></TD></TR><TR><TD PORT="admin_id" ALIGN="LEFT">admin_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>FK</B></FONT></TD></TR><TR><TD PORT="coleta_id" ALIGN="LEFT">coleta_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>FK</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#5f6d73">+ 7 colunas</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_visitantes { label="Visitantes (portal)"; style="rounded,filled"; color="#d8ccbf"; fillcolor="#f2efe9"; fontsize=16; fontcolor="#263b5c";
    "visitante" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9c836f" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#263b5c"><FONT COLOR="#ffffff"><B>visitante</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#5f6d73">+ 4 colunas</FONT></TD></TR></TABLE>>];
    "visitante_tema" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9c836f" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#263b5c"><FONT COLOR="#ffffff"><B>visitante_tema</B></FONT></TD></TR><TR><TD PORT="visitante_id" ALIGN="LEFT">visitante_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK FK</B></FONT></TD></TR><TR><TD PORT="cod_tema" ALIGN="LEFT">cod_tema</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK FK</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#5f6d73">+ 1 coluna</FONT></TD></TR></TABLE>>];
  }
  "tema" [shape=box, style="rounded,dashed", color="#9c836f", fontcolor="#5f6d73", label="tema\n(Proposições (API da Câmara))"];
  "noticia":"id" -> "geracao_ia":"noticia_id" [arrowtail=teeodot, arrowhead=crowodot];
  "geracao_ia":"id" -> "geracao_trecho":"geracao_id" [arrowtail=teetee, arrowhead=crowodot];
  "trecho_rag":"id" -> "geracao_trecho":"trecho_id" [arrowtail=teetee, arrowhead=crowodot];
  "administrador":"id" -> "log_sistema":"admin_id" [arrowtail=teeodot, arrowhead=crowodot];
  "coleta":"id" -> "log_sistema":"coleta_id" [arrowtail=teeodot, arrowhead=crowodot];
  "tema" -> "noticia":"cod_tema" [arrowtail=teetee, arrowhead=crowodot];
  "noticia":"id" -> "noticia_fonte":"noticia_id" [arrowtail=teetee, arrowhead=crowodot];
  "administrador":"id" -> "noticia_revisao":"admin_id" [arrowtail=teetee, arrowhead=crowodot];
  "noticia":"id" -> "noticia_revisao":"noticia_id" [arrowtail=teetee, arrowhead=crowodot];
  "tema" -> "visitante_tema":"cod_tema" [arrowtail=teetee, arrowhead=crowodot];
  "visitante":"id" -> "visitante_tema":"visitante_id" [arrowtail=teetee, arrowhead=crowodot];
}
