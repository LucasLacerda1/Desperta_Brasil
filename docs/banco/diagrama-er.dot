digraph modelo_do_banco {
  graph [rankdir=TB, splines=ortho, nodesep=0.7, ranksep=1.1, pad=0.5, bgcolor="#ffffff", fontname="Helvetica", fontsize=30, labelloc=t, label="Desperta Brasil: diagrama entidade-relacionamento do banco de dados\n "];
  node [shape=plain, fontname="Helvetica", fontsize=13];
  edge [color="#4a5560", penwidth=1.3, arrowsize=0.9, dir=both];
  legenda [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#3d4650" BGCOLOR="#ffffff"><TR><TD ALIGN="LEFT"><B>Legenda</B></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1f4f99"><B>azul</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#3d4650">tabela que espelha a API da Câmara (21)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#2b7148"><B>verde</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#3d4650">tabela própria do portal (11)</FONT></TD></TR><TR><TD ALIGN="LEFT">«entidade forte»</TD><TD ALIGN="LEFT"><FONT COLOR="#3d4650">chave primária própria, existe sozinha (18)</FONT></TD></TR><TR><TD ALIGN="LEFT">«entidade associativa»</TD><TD ALIGN="LEFT"><FONT COLOR="#3d4650">borda tracejada: resolve um N:N (10)</FONT></TD></TR><TR><TD ALIGN="LEFT">«entidade fraca»</TD><TD ALIGN="LEFT"><FONT COLOR="#3d4650">borda dupla: só existe ligada à tabela pai (4)</FONT></TD></TR><TR><TD ALIGN="LEFT">entidade abstrata</TD><TD ALIGN="LEFT"><FONT COLOR="#3d4650">nenhuma: o modelo não tem herança</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> · <B>FK</B> · <B>UQ</B></TD><TD ALIGN="LEFT"><FONT COLOR="#3d4650">chave primária · chave estrangeira · valor único</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>negrito</B> · <B>?</B></TD><TD ALIGN="LEFT"><FONT COLOR="#3d4650">faz parte da PK · aceita nulo</FONT></TD></TR><TR><TD ALIGN="LEFT">||-------o&lt;</TD><TD ALIGN="LEFT"><FONT COLOR="#3d4650">exatamente um para zero ou muitos (FK obrigatória)</FONT></TD></TR><TR><TD ALIGN="LEFT">o|-------o&lt;</TD><TD ALIGN="LEFT"><FONT COLOR="#3d4650">zero ou um para zero ou muitos (FK que aceita nulo)</FONT></TD></TR><TR><TD ALIGN="LEFT">tipo + ref_id</TD><TD ALIGN="LEFT"><FONT COLOR="#3d4650">noticia_fonte e trecho_rag apontam para a Câmara sem FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>Total</B></TD><TD ALIGN="LEFT"><FONT COLOR="#3d4650">32 tabelas · 42 relacionamentos 1:N · 10 N:N</FONT></TD></TR></TABLE>>];
  "administrador" [ label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3d4650" BGCOLOR="#ffffff"><TR><TD COLSPAN="4" BGCOLOR="#2b7148" CELLPADDING="5"><FONT COLOR="#ffffff" POINT-SIZE="15"><B>administrador</B></FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#e8edf5"><FONT POINT-SIZE="11">«entidade forte»</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8a4f12" POINT-SIZE="11"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD WIDTH="14"> </TD><TD ALIGN="LEFT"><FONT COLOR="#56626c" POINT-SIZE="11">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">nome</TD><TD WIDTH="14"> </TD><TD ALIGN="LEFT"><FONT COLOR="#56626c" POINT-SIZE="11">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8a4f12" POINT-SIZE="11"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">email</TD><TD WIDTH="14"> </TD><TD ALIGN="LEFT"><FONT COLOR="#56626c" POINT-SIZE="11">VARCHAR(254)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">senha_hash</TD><TD WIDTH="14"> </TD><TD ALIGN="LEFT"><FONT COLOR="#56626c" POINT-SIZE="11">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">papel</TD><TD WIDTH="14"> </TD><TD ALIGN="LEFT"><FONT COLOR="#56626c" POINT-SIZE="11">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">ativo</TD><TD WIDTH="14"> </TD><TD ALIGN="LEFT"><FONT COLOR="#56626c" POINT-SIZE="11">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">criado_em</TD><TD WIDTH="14"> </TD><TD ALIGN="LEFT"><FONT COLOR="#56626c" POINT-SIZE="11">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">atualizado_em</TD><TD WIDTH="14"> </TD><TD ALIGN="LEFT"><FONT COLOR="#56626c" POINT-SIZE="11">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">ultimo_acesso<FONT COLOR="#b0491c"><B> ?</B></FONT></TD><TD WIDTH="14"> </TD><TD ALIGN="LEFT"><FONT COLOR="#56626c" POINT-SIZE="11">DATETIME</FONT></TD></TR></TABLE>>];
