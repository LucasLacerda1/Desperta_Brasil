  "votacao":"id" -> "pauta_item":"votacao_id" [arrowtail=teeodot, arrowhead=crowodot];
  "deputado":"id" -> "proposicao_autor":"deputado_id" [arrowtail=teeodot, arrowhead=crowodot];
  "proposicao":"id" -> "proposicao_autor":"proposicao_id" [arrowtail=teetee, arrowhead=crowodot];
  "tema":"cod_tema" -> "proposicao_tema":"cod_tema" [arrowtail=teetee, arrowhead=crowodot];
