digraph modelo_do_banco {
  graph [rankdir=TB, splines=true, nodesep=0.25, ranksep=0.7, pad=0.4, bgcolor="#fefdfb", fontname="Helvetica", fontsize=22, labelloc=t, label="Desperta Brasil: dados da Câmara (21 tabelas)"];
  node [shape=plain, fontname="Helvetica", fontsize=12];
  edge [color="#956036", penwidth=1.1, arrowsize=0.8, dir=both];
  subgraph cluster_proposicoes { label="Proposições (API da Câmara)"; style="rounded,filled"; color="#d8ccbf"; fillcolor="#f6efe6"; fontsize=16; fontcolor="#263b5c";
    "proposicao" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9c836f" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#263b5c"><FONT COLOR="#ffffff"><B>proposicao</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#5f6d73">+ 20 colunas</FONT></TD></TR></TABLE>>];
    "proposicao_autor" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9c836f" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#263b5c"><FONT COLOR="#ffffff"><B>proposicao_autor</B></FONT></TD></TR><TR><TD PORT="proposicao_id" ALIGN="LEFT">proposicao_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK FK</B></FONT></TD></TR><TR><TD PORT="ordem" ALIGN="LEFT">ordem</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK</B></FONT></TD></TR><TR><TD PORT="deputado_id" ALIGN="LEFT">deputado_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>FK</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#5f6d73">+ 5 colunas</FONT></TD></TR></TABLE>>];
    "proposicao_tema" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9c836f" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#263b5c"><FONT COLOR="#ffffff"><B>proposicao_tema</B></FONT></TD></TR><TR><TD PORT="proposicao_id" ALIGN="LEFT">proposicao_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK FK</B></FONT></TD></TR><TR><TD PORT="cod_tema" ALIGN="LEFT">cod_tema</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK FK</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#5f6d73">+ 2 colunas</FONT></TD></TR></TABLE>>];
    "tema" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9c836f" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#263b5c"><FONT COLOR="#ffffff"><B>tema</B></FONT></TD></TR><TR><TD PORT="cod_tema" ALIGN="LEFT">cod_tema</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#5f6d73">+ 6 colunas</FONT></TD></TR></TABLE>>];
    "tramitacao" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9c836f" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#263b5c"><FONT COLOR="#ffffff"><B>tramitacao</B></FONT></TD></TR><TR><TD PORT="proposicao_id" ALIGN="LEFT">proposicao_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK FK</B></FONT></TD></TR><TR><TD PORT="sequencia" ALIGN="LEFT">sequencia</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK</B></FONT></TD></TR><TR><TD PORT="orgao_id" ALIGN="LEFT">orgao_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>FK</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#5f6d73">+ 12 colunas</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_votacoes { label="Votações (API da Câmara)"; style="rounded,filled"; color="#d8ccbf"; fillcolor="#eef2f7"; fontsize=16; fontcolor="#263b5c";
    "orientacao" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9c836f" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#263b5c"><FONT COLOR="#ffffff"><B>orientacao</B></FONT></TD></TR><TR><TD PORT="votacao_id" ALIGN="LEFT">votacao_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK FK</B></FONT></TD></TR><TR><TD PORT="partido_bloco" ALIGN="LEFT">partido_bloco</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK</B></FONT></TD></TR><TR><TD PORT="partido_id" ALIGN="LEFT">partido_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>FK</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#5f6d73">+ 3 colunas</FONT></TD></TR></TABLE>>];
    "votacao" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9c836f" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#263b5c"><FONT COLOR="#ffffff"><B>votacao</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK</B></FONT></TD></TR><TR><TD PORT="evento_id" ALIGN="LEFT">evento_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>FK</B></FONT></TD></TR><TR><TD PORT="orgao_id" ALIGN="LEFT">orgao_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>FK</B></FONT></TD></TR><TR><TD PORT="proposicao_id" ALIGN="LEFT">proposicao_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>FK</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#5f6d73">+ 10 colunas</FONT></TD></TR></TABLE>>];
    "votacao_proposicao" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9c836f" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#263b5c"><FONT COLOR="#ffffff"><B>votacao_proposicao</B></FONT></TD></TR><TR><TD PORT="votacao_id" ALIGN="LEFT">votacao_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK FK</B></FONT></TD></TR><TR><TD PORT="proposicao_id" ALIGN="LEFT">proposicao_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK FK</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#5f6d73">+ 1 coluna</FONT></TD></TR></TABLE>>];
    "voto" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9c836f" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#263b5c"><FONT COLOR="#ffffff"><B>voto</B></FONT></TD></TR><TR><TD PORT="votacao_id" ALIGN="LEFT">votacao_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK FK</B></FONT></TD></TR><TR><TD PORT="deputado_id" ALIGN="LEFT">deputado_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK FK</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#5f6d73">+ 4 colunas</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_parlamentares { label="Parlamentares (API da Câmara)"; style="rounded,filled"; color="#d8ccbf"; fillcolor="#f3f0ea"; fontsize=16; fontcolor="#263b5c";
    "bloco" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9c836f" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#263b5c"><FONT COLOR="#ffffff"><B>bloco</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK</B></FONT></TD></TR><TR><TD PORT="id_legislatura" ALIGN="LEFT">id_legislatura</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>FK</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#5f6d73">+ 7 colunas</FONT></TD></TR></TABLE>>];
    "bloco_partido" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9c836f" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#263b5c"><FONT COLOR="#ffffff"><B>bloco_partido</B></FONT></TD></TR><TR><TD PORT="bloco_id" ALIGN="LEFT">bloco_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK FK</B></FONT></TD></TR><TR><TD PORT="partido_id" ALIGN="LEFT">partido_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK FK</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#5f6d73">+ 1 coluna</FONT></TD></TR></TABLE>>];
    "deputado" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9c836f" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#263b5c"><FONT COLOR="#ffffff"><B>deputado</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK</B></FONT></TD></TR><TR><TD PORT="id_legislatura" ALIGN="LEFT">id_legislatura</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>FK</B></FONT></TD></TR><TR><TD PORT="partido_id" ALIGN="LEFT">partido_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>FK</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#5f6d73">+ 10 colunas</FONT></TD></TR></TABLE>>];
    "frente" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9c836f" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#263b5c"><FONT COLOR="#ffffff"><B>frente</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK</B></FONT></TD></TR><TR><TD PORT="id_legislatura" ALIGN="LEFT">id_legislatura</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>FK</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#5f6d73">+ 7 colunas</FONT></TD></TR></TABLE>>];
    "frente_membro" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9c836f" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#263b5c"><FONT COLOR="#ffffff"><B>frente_membro</B></FONT></TD></TR><TR><TD PORT="frente_id" ALIGN="LEFT">frente_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK FK</B></FONT></TD></TR><TR><TD PORT="deputado_id" ALIGN="LEFT">deputado_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK FK</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#5f6d73">+ 5 colunas</FONT></TD></TR></TABLE>>];
    "legislatura" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9c836f" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#263b5c"><FONT COLOR="#ffffff"><B>legislatura</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#5f6d73">+ 6 colunas</FONT></TD></TR></TABLE>>];
    "lideranca" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9c836f" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#263b5c"><FONT COLOR="#ffffff"><B>lideranca</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK</B></FONT></TD></TR><TR><TD PORT="deputado_id" ALIGN="LEFT">deputado_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>FK</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#5f6d73">+ 9 colunas</FONT></TD></TR></TABLE>>];
    "partido" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9c836f" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#263b5c"><FONT COLOR="#ffffff"><B>partido</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#5f6d73">+ 7 colunas</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_orgaos { label="Órgãos e eventos (API da Câmara)"; style="rounded,filled"; color="#d8ccbf"; fillcolor="#edf3f4"; fontsize=16; fontcolor="#263b5c";
    "deputado_orgao" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9c836f" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#263b5c"><FONT COLOR="#ffffff"><B>deputado_orgao</B></FONT></TD></TR><TR><TD PORT="deputado_id" ALIGN="LEFT">deputado_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK FK</B></FONT></TD></TR><TR><TD PORT="orgao_id" ALIGN="LEFT">orgao_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK FK</B></FONT></TD></TR><TR><TD PORT="data_inicio" ALIGN="LEFT">data_inicio</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#5f6d73">+ 4 colunas</FONT></TD></TR></TABLE>>];
    "evento" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9c836f" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#263b5c"><FONT COLOR="#ffffff"><B>evento</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK</B></FONT></TD></TR><TR><TD PORT="orgao_id" ALIGN="LEFT">orgao_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>FK</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#5f6d73">+ 13 colunas</FONT></TD></TR></TABLE>>];
    "orgao" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9c836f" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#263b5c"><FONT COLOR="#ffffff"><B>orgao</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#5f6d73">+ 10 colunas</FONT></TD></TR></TABLE>>];
    "pauta_item" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9c836f" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#263b5c"><FONT COLOR="#ffffff"><B>pauta_item</B></FONT></TD></TR><TR><TD PORT="evento_id" ALIGN="LEFT">evento_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK FK</B></FONT></TD></TR><TR><TD PORT="ordem" ALIGN="LEFT">ordem</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>PK</B></FONT></TD></TR><TR><TD PORT="proposicao_id" ALIGN="LEFT">proposicao_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>FK</B></FONT></TD></TR><TR><TD PORT="relator_id" ALIGN="LEFT">relator_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>FK</B></FONT></TD></TR><TR><TD PORT="votacao_id" ALIGN="LEFT">votacao_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6d4727"><B>FK</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#5f6d73">+ 6 colunas</FONT></TD></TR></TABLE>>];
  }
  "legislatura":"id" -> "bloco":"id_legislatura" [arrowtail=teetee, arrowhead=crowodot];
  "bloco":"id" -> "bloco_partido":"bloco_id" [arrowtail=teetee, arrowhead=crowodot];
  "partido":"id" -> "bloco_partido":"partido_id" [arrowtail=teetee, arrowhead=crowodot];
