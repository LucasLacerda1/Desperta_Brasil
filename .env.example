# Copie para .env (nunca versionar o .env)
SECRET_KEY=troque-esta-chave
DATABASE_URL=sqlite:///desperta.db
# Pasta dos modelos do projeto (decisao 21.2)
MODELOS_DIR=instance/modelos
# So a RoBERTaLexPT-base; com o pendrive: /media/<usuario>/DESPERTA/roberta-lexpt-base
ROBERTA_DIR=instance/modelos/roberta-lexpt-base
ROBERTA_ESCRITORA_DIR=instance/modelos/roberta-escritora
# Depois de flask ia baixar-modelo, use HF_HUB_OFFLINE=1
HF_HUB_OFFLINE=0
# auto (usa a placa NVIDIA se existir, como a RTX 4050), cuda (exige a placa) ou cpu (decisao 20.2)
IA_DISPOSITIVO=auto
# Quem escreve as noticias: falso, frases ou roberta (decisao 17.2)
GERADOR=frases
# Quantos dias para tras o flask ia gerar-novos olha (votacoes, situacoes e proposicoes novas)
GERACAO_JANELA_DIAS=3
# Peso da lista vetorial no modo hibrida_peso (decisao 19.2)
RAG_PESO_VETOR=0.5
# Limites da rotina horaria (decisao 15.3)
HORARIA_ORCAMENTO_MIN=20
HORARIA_RECONFERIR_HORAS=6
# Origens do front-end que podem chamar a API com o cookie de sessao, separadas por virgula (decisao 10.5)
CORS_ORIGINS=http://localhost:5173
# 1 em producao, com HTTPS (o cookie de sessao so viaja por HTTPS)
SESSION_COOKIE_SECURE=0
